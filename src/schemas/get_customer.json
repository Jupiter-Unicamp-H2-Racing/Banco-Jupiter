{
"title": "GetCustomers",
"type": "object",
"properties": {
"limit": {
"type": "string",
"pattern": "^(100|[1-9][0-9]?)$"
},
"page": {
"type": "string",
"pattern": "^[1-9][0-9]*$"
},
"status": {
"type": "array",
"minItems": 1,
"items": {
"type": "string",
"enum": [
"pending_kyc",
"active",
"blocked",
"inactive"
]
}
},
"name": {
"type": "string",
"minLength": 1,
"maxLength": 255
},
"email": {
"type": "string",
"minLength": 1,
"maxLength": 255
},
"document_number": {
"type": "string",
"pattern": "^\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}$"
},
"birthdate_from": {
"type": "string",
"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
},
"birthdate_to": {
"type": "string",
"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
}
},
"additionalProperties": false
}
